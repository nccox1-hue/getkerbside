# DVSA MOT History API — OAuth2 client credentials (key received 2026-06-04)
# Copy values from the automotive-app-repo/automotive-app/.env
DVSA_CLIENT_ID=
DVSA_CLIENT_SECRET=
DVSA_API_KEY=

# DVLA Vehicle Enquiry Service — apply at:
# https://developer-portal.driver-vehicle-licensing.api.gov.uk/
DVLA_API_KEY=
# Use the UAT host for test keys, the production host for live keys:
#   test: https://uat.driver-vehicle-licensing.api.gov.uk/vehicle-enquiry/v1/vehicles
#   live: https://driver-vehicle-licensing.api.gov.uk/vehicle-enquiry/v1/vehicles
DVLA_BASE_URL=

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=https://getkerbside.co.uk,http://localhost:3000,http://127.0.0.1:3000
