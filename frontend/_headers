# Cloudflare Pages response headers. Mirrors SECURITY_HEADERS in backend/app/main.py,
# which only applies while Render serves the frontend.
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# The service worker must always be revalidated, or a new cache version never reaches users
/service-worker.js
  Cache-Control: no-cache
